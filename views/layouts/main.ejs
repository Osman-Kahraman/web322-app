<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="X-UA-Compatible" content="ie=edge" />
        <!-- Latest compiled and minified Bootstrap 5 CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous" />
        <link rel="stylesheet" href="/css/main.css" />
        <link href="https://fonts.googleapis.com/css2?family=Doto:wght@100..900&display=swap" rel="stylesheet">

        <title>
            <% if (pageTitle) { %>
                <%= pageTitle %> | Osman Kahraman
            <% } else { %>
                Osman Kahraman
            <% } %>
        </title>
    </head>
    <body>
        <div class="container" id="fade-in">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top" id="border-glow">
                <div class="container-fluid">
                    <!-- Brand and toggle get grouped for better mobile display -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <a class="navbar-brand" href="/">WEB322 - Osman KAHRAMAN</a>
    
                    <!-- Collect the nav links, forms, and other content for toggling -->
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav">
                            <%- navLink('/shop', 'Shop') %>
                            <%- navLink('/about', 'About') %>
                            <% if (session.user) { %>
                                <%- navLink('/items', 'Items') %>
                                <%- navLink('/categories', 'Categories') %>
                            <% } %>
                        </ul>
                    </div>
                    <div style="float: right;">
                        <ul class="navbar-nav ml-auto">
                            <li class="ml-3" style="margin: 5px;">
                                <a class="text-muted" href="https://github.com/Osman-Kahraman"
                                  ><img
                                    class="github"
                                    src="https://github.githubassets.com/assets/GitHub-Mark-ea2971cee799.png"
                                    width="30"
                                    height="30"
                                /></a>
                            </li>
                            <li class="ml-3" style="margin: 5px;">
                                <a class="text-muted" href="https://www.linkedin.com/in/osman-kahraman-2a6513220/"
                                 ><img
                                    class="linkedin"
                                    src="https://content.linkedin.com/content/dam/me/business/en-us/amp/brand-site/v2/bg/LI-Bug.svg.original.svg"
                                    width="30"
                                    height="30"
                                /></a>
                            </li>
                            <% if (session.user) { %>
                                <li><a href="#" style="padding: 20px;"><%- session.user.userName %></a>
                                <ul>
                                    <li><a href="/userHistory" style="padding: 20px;">User History</a></li>
                                    <li><a href="/logout" style="padding: 20px;">Log Out</a></li>
                                </ul>
                            <% } else { %>
                                <ul class="navbar-nav">
                                    <%- navLink('/register', 'Register') %>
                                    <%- navLink('/login', 'LOGIN') %>
                                </ul>
                            <% } %>
                        </ul>
                    </div>
                    <!-- /.navbar-collapse -->
                </div>
                <!-- /.container-fluid -->
            </nav>
            <div class="container" style="padding-top: 90px;">
                <%- body %>
            </div>
        </div>

        <!-- Latest compiled and minified Bootstrap 5 JavaScript -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.3/gsap.min.js"></script>
    </body>
</html>